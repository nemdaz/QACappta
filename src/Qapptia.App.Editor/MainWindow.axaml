<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Qapptia.App.Editor.ViewModels"
        xmlns:nav="clr-namespace:Qapptia.Editor.Models.Navigation;assembly=Qapptia.Editor"
        xmlns:controls="clr-namespace:Qapptia.App.Editor.Controls"
        xmlns:shared="clr-namespace:Qapptia.UI.Components.Controls;assembly=Qapptia.UI.Components"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="Qapptia.App.Editor.MainWindow"
        x:DataType="vm:EditorViewModel"
        Title="Qapptia - Editor"
        Icon="avares://Qapptia.App.Editor/Assets/app_icon.ico"
        Background="{DynamicResource M3SurfaceBrush}"
        WindowStartupLocation="CenterScreen">

    <Grid RowDefinitions="Auto, *, Auto">
        
        <!-- Top Toolbar -->
        <controls:EditorToolbarWidget Grid.Row="0" />

        <!-- Main Content Area -->
        <Grid Grid.Row="1" x:Name="MainGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="250" />
            </Grid.ColumnDefinitions>
            
            <!-- Canvas Viewer -->
            <ScrollViewer Grid.Column="0" x:Name="EditorScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Panel Background="{DynamicResource M3SurfaceContainerHighestBrush}">
                    <!-- Mensaje si NO hay imagen -->
                    <TextBlock Text="Selecciona una imagen del Explorador para comenzar a editar." 
                               Foreground="{DynamicResource M3OnSurfaceVariantBrush}" FontSize="16" 
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsVisible="{Binding HasNoImage}" />

                    <!-- Lienzo con fondo blanco (Visible solo cuando hay imagen) -->
                    <LayoutTransformControl HorizontalAlignment="Center" VerticalAlignment="Center" Margin="32" IsVisible="{Binding HasImage}">
                        <LayoutTransformControl.LayoutTransform>
                            <ScaleTransform ScaleX="{Binding ZoomLevel}" ScaleY="{Binding ZoomLevel}" />
                        </LayoutTransformControl.LayoutTransform>
                        <Border BoxShadow="0 4 16 0 #20000000" Width="{Binding ImageWidth}" Height="{Binding ImageHeight}" ClipToBounds="False">
                            <Panel ClipToBounds="False">
                                <controls:BoardCanvas x:Name="MainCanvas" ViewModel="{Binding}" />
                                <Canvas ClipToBounds="False">
                                    <controls:TextEditorWidget x:Name="TextOverlay" IsVisible="{Binding IsEditingText}"
                                                               Canvas.Left="{Binding CurrentTextBounds.X}"
                                                               Canvas.Top="{Binding CurrentTextBounds.Y}" />
                                </Canvas>
                            </Panel>
                        </Border>
                    </LayoutTransformControl>
                </Panel>
            </ScrollViewer>

            <!-- Toast Overlay -->
            <shared:ToastWidget Grid.Column="0" Grid.ColumnSpan="3"
                                HorizontalAlignment="{Binding ToastAlignment}" VerticalAlignment="Top"
                                Margin="16,16,16,0"
                                ZIndex="999"
                                Message="{Binding ToastMessage}"
                                Type="{Binding ToastType}"
                                IsOpen="{Binding IsToastVisible}" />

            <GridSplitter Grid.Column="1" Width="4" Background="{DynamicResource M3OutlineVariantBrush}" ResizeDirection="Columns" />

            <!-- Right Sidebar (Explorador) -->
            <Border Grid.Column="2" Background="{DynamicResource M3SurfaceContainerBrush}" BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="1,0,0,0">
                <Grid RowDefinitions="Auto, *">
                    <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="12,12,12,8">
                        <TextBlock Grid.Column="0" Text="Explorador" Foreground="{DynamicResource M3OnSurfaceBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <!-- Recargar -->
                        <Button Grid.Column="1" Command="{Binding LoadSidebarImagesCommand}" Background="Transparent" Padding="4,2" ToolTip.Tip="Recargar">
                            <PathIcon Data="{StaticResource IconRefresh}" Width="14" Height="14"/>
                        </Button>
                    </Grid>
                    
                    <TreeView Grid.Row="1" ItemsSource="{Binding SidebarFolders}" SelectedItem="{Binding SelectedNode}" Background="Transparent" BorderThickness="0">
                        <TreeView.ItemContainerTheme>
                            <ControlTheme TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}" x:DataType="nav:NavigationItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            </ControlTheme>
                        </TreeView.ItemContainerTheme>
                        <TreeView.Styles>
                            <Style Selector="ToggleButton#PART_ExpandCollapseChevron">
                                <Setter Property="Width" Value="18" />
                                <Setter Property="Height" Value="18" />
                                <Setter Property="Margin" Value="0,0,6,0" />
                                <Setter Property="Template">
                                    <ControlTemplate>
                                        <Border Background="Transparent">
                                            <PathIcon x:Name="FolderIcon" Classes="folder" Width="16" Height="16" Foreground="{DynamicResource M3OnSurfaceVariantBrush}"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter>
                            </Style>
                            <Style Selector="ToggleButton#PART_ExpandCollapseChevron /template/ PathIcon.folder">
                                <!-- Carpeta cerrada -->
                                <Setter Property="Data" Value="{StaticResource IconFolder}" />
                            </Style>
                            <Style Selector="ToggleButton#PART_ExpandCollapseChevron:checked /template/ PathIcon.folder">
                                <!-- Carpeta abierta -->
                                <Setter Property="Data" Value="{StaticResource IconFolderOpen}" />
                            </Style>
                        </TreeView.Styles>
                        <TreeView.DataTemplates>
                            <TreeDataTemplate DataType="nav:FolderItem" ItemsSource="{Binding Items}">
                                <StackPanel Orientation="Horizontal" Spacing="6" Background="Transparent">
                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource M3OnSurfaceBrush}" FontWeight="SemiBold" FontSize="13" Padding="0,2" VerticalAlignment="Center" />
                                </StackPanel>
                            </TreeDataTemplate>
                            <DataTemplate DataType="nav:FileItem">
                                <Border Background="Transparent" PointerPressed="FileItem_PointerPressed">
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Abrir"
                                                      Command="{Binding $parent[Window].((vm:EditorViewModel)DataContext).OpenFileCommand}"
                                                      CommandParameter="{Binding}" />
                                            <MenuItem Header="Mostrar en carpeta"
                                                      Command="{Binding $parent[Window].((vm:EditorViewModel)DataContext).ShowInFolderCommand}"
                                                      CommandParameter="{Binding}" />
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <StackPanel Orientation="Horizontal" Spacing="6" Background="Transparent" Margin="2,0,0,0">
                                        <!-- Imagen -->
                                        <PathIcon Data="{StaticResource IconImage}" Width="14" Height="14" Foreground="{DynamicResource M3OnSurfaceVariantBrush}"/>
                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource M3OnSurfaceBrush}" FontSize="13" Padding="0,2" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </TreeView.DataTemplates>
                    </TreeView>
                </Grid>
            </Border>
            
        </Grid>

        <!-- Status Bar (Footer) -->
        <Border Grid.Row="2" Background="{DynamicResource M3SurfaceContainerHighBrush}" BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="0,1,0,0" Padding="12,4">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasImage}" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ImageWidth}" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" FontSize="11" />
                    <TextBlock Text="x" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" FontSize="11" />
                    <TextBlock Text="{Binding ImageHeight}" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" FontSize="11" />
                    <TextBlock Text="px" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" FontSize="11" />
                </StackPanel>
                
                <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <TextBlock Text="Listo" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" FontSize="11" />
                    <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding HasImage}">
                        <TextBlock Text="Archivo:" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" FontSize="11" />
                        <TextBlock Text="{Binding SelectedNode.Name}" Foreground="{DynamicResource M3OnSurfaceBrush}" FontSize="11" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

    </Grid>
</Window>
