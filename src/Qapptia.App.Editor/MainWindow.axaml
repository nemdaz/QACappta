<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Qapptia.App.Editor.ViewModels"
        xmlns:nav="clr-namespace:Qapptia.Editor.Models.Navigation;assembly=Qapptia.Editor"
        xmlns:converters="clr-namespace:Qapptia.App.Editor.Converters"
        xmlns:controls="clr-namespace:Qapptia.App.Editor.Controls"
        xmlns:shared="clr-namespace:Qapptia.UI.Components.Controls;assembly=Qapptia.UI.Components"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="Qapptia.App.Editor.MainWindow"
        x:DataType="vm:EditorViewModel"
        Title="Qapptia - Editor"
        Icon="avares://Qapptia.App.Editor/Assets/app_icon.ico"
        Background="{DynamicResource M3SurfaceBrush}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <converters:ResourceKeyToGeometryConverter x:Key="KeyToGeometryConverter" />
        <converters:BoolToDimmedOpacityConverter x:Key="BoolToDimmedOpacityConverter" />
    </Window.Resources>

    <Window.Styles>
        <Style Selector="Button.sidebar-toggle">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="5,3" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="Button.sidebar-toggle PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceVariantBrush}" />
        </Style>
        <Style Selector="Button.sidebar-toggle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource M3HoverBrush}" />
        </Style>
        <Style Selector="Button.sidebar-toggle:pointerover PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceBrush}" />
        </Style>
        <Style Selector="Button.sidebar-toggle.active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource M3GrayContainerBrush}" />
        </Style>
        <Style Selector="Button.sidebar-toggle.active PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource M3OnGrayContainerBrush}" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto, *, Auto">
        
        <!-- Top Toolbar -->
        <controls:EditorToolbarWidget Grid.Row="0" />

        <!-- Main Content Area -->
        <Grid Grid.Row="1" x:Name="MainGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="250" />
            </Grid.ColumnDefinitions>
            
            <!-- Canvas Viewer -->
            <ScrollViewer Grid.Column="0" x:Name="EditorScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Panel Background="{DynamicResource M3SurfaceContainerHighestBrush}">
                    <!-- Mensaje si NO hay imagen -->
                    <TextBlock Text="Selecciona una imagen del Explorador para comenzar a editar." 
                               Foreground="{DynamicResource M3OnSurfaceVariantBrush}" FontSize="16" 
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsVisible="{Binding HasNoImage}" />

                    <!-- Lienzo con fondo blanco (Visible solo cuando hay imagen) -->
                    <LayoutTransformControl HorizontalAlignment="Center" VerticalAlignment="Center" Margin="32" IsVisible="{Binding HasImage}">
                        <LayoutTransformControl.LayoutTransform>
                            <ScaleTransform ScaleX="{Binding ZoomLevel}" ScaleY="{Binding ZoomLevel}" />
                        </LayoutTransformControl.LayoutTransform>
                        <Border BoxShadow="0 4 16 0 #20000000" Width="{Binding ImageWidth}" Height="{Binding ImageHeight}" ClipToBounds="False">
                            <Panel ClipToBounds="False">
                                <controls:BoardCanvas x:Name="MainCanvas" ViewModel="{Binding}" />
                                <Canvas ClipToBounds="False">
                                    <controls:TextEditorWidget x:Name="TextOverlay" IsVisible="{Binding IsEditingText}"
                                                               Canvas.Left="{Binding CurrentTextBounds.X}"
                                                               Canvas.Top="{Binding CurrentTextBounds.Y}" />
                                </Canvas>
                            </Panel>
                        </Border>
                    </LayoutTransformControl>
                </Panel>
            </ScrollViewer>

            <!-- Toast Overlay -->
            <shared:ToastWidget Grid.Column="0" Grid.ColumnSpan="3"
                                HorizontalAlignment="{Binding ToastAlignment}" VerticalAlignment="Top"
                                Margin="16,16,16,0"
                                ZIndex="999"
                                Message="{Binding ToastMessage}"
                                Type="{Binding ToastType}"
                                IsOpen="{Binding IsToastVisible}" />

            <GridSplitter Grid.Column="1" Width="4" Background="{DynamicResource M3OutlineVariantBrush}" ResizeDirection="Columns" />

            <!-- Right Sidebar (Explorador) -->
            <Border Grid.Column="2" Background="{DynamicResource M3SurfaceContainerBrush}" BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="1,0,0,0">
                <Grid RowDefinitions="Auto, *">
                    <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="12,10,12,8">
                        <TextBlock Grid.Column="0" Text="Explorador" Foreground="{DynamicResource M3OnSurfaceBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                            <!-- Selector de vistas [ Árbol | Calendario ] -->
                            <Button Command="{Binding SetSidebarViewModeCommand}"
                                    CommandParameter="{x:Static vm:SidebarViewMode.Tree}"
                                    Classes="sidebar-toggle"
                                    Classes.active="{Binding IsTreeViewActive}"
                                    ToolTip.Tip="Vista de árbol">
                                <PathIcon Data="{StaticResource IconAccountTree}" Width="13" Height="13"/>
                            </Button>
                            <Button Command="{Binding SetSidebarViewModeCommand}"
                                    CommandParameter="{x:Static vm:SidebarViewMode.Calendar}"
                                    Classes="sidebar-toggle"
                                    Classes.active="{Binding IsCalendarViewActive}"
                                    ToolTip.Tip="Vista de calendario">
                                <PathIcon Data="{StaticResource IconCalendarMonth}" Width="13" Height="13"/>
                            </Button>

                            <!-- Recargar (homologado a 13x13 y sutil) -->
                            <Button Command="{Binding LoadSidebarImagesCommand}" Classes="sidebar-toggle" ToolTip.Tip="Recargar" Margin="2,0,0,0">
                                <PathIcon Data="{StaticResource IconRefresh}" Width="13" Height="13"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                    
                    <TreeView Grid.Row="1" ItemsSource="{Binding SidebarGroups}" SelectedItem="{Binding SelectedNode}" Background="Transparent" BorderThickness="0">
                        <TreeView.ItemContainerTheme>
                            <ControlTheme TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}" x:DataType="nav:NavigationItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            </ControlTheme>
                        </TreeView.ItemContainerTheme>
                        <TreeView.Styles>
                            <Style Selector="ToggleButton#PART_ExpandCollapseChevron">
                                <Setter Property="Width" Value="12" />
                                <Setter Property="Height" Value="12" />
                                <Setter Property="Margin" Value="0,0,2,0" />
                                <Setter Property="Template">
                                    <ControlTemplate>
                                        <Border Background="Transparent" Width="12" Height="12">
                                            <PathIcon x:Name="ChevronIcon" Data="{StaticResource IconChevronRight}" Width="8" Height="8" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" RenderTransformOrigin="50%,50%">
                                                <PathIcon.RenderTransform>
                                                    <RotateTransform Angle="0" />
                                                </PathIcon.RenderTransform>
                                                <PathIcon.Transitions>
                                                    <Transitions>
                                                        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" />
                                                    </Transitions>
                                                </PathIcon.Transitions>
                                            </PathIcon>
                                        </Border>
                                    </ControlTemplate>
                                </Setter>
                            </Style>
                            <Style Selector="ToggleButton#PART_ExpandCollapseChevron:checked /template/ PathIcon#ChevronIcon">
                                <Setter Property="RenderTransform" Value="rotate(90deg)" />
                            </Style>
                            <!-- Reserva de espacio homogéneo compacto para ítems sin hijos garantizando alineación vertical estricta -->
                            <Style Selector="TreeViewItem:empty /template/ ToggleButton#PART_ExpandCollapseChevron">
                                <Setter Property="IsVisible" Value="True" />
                                <Setter Property="Opacity" Value="0" />
                                <Setter Property="IsHitTestVisible" Value="False" />
                            </Style>
                        </TreeView.Styles>
                        <TreeView.DataTemplates>
                            <TreeDataTemplate DataType="nav:GroupItem" ItemsSource="{Binding Items}">
                                <StackPanel Orientation="Horizontal" Spacing="6" Background="Transparent"
                                            Opacity="{Binding IsDimmed, Converter={StaticResource BoolToDimmedOpacityConverter}}">
                                    <PathIcon Data="{Binding IconKey, Converter={StaticResource KeyToGeometryConverter}}"
                                              Width="14" Height="14"
                                              Foreground="{DynamicResource M3OnSurfaceVariantBrush}"/>
                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource M3OnSurfaceBrush}" FontWeight="SemiBold" FontSize="13" Padding="0,2" VerticalAlignment="Center" />
                                </StackPanel>
                            </TreeDataTemplate>
                            <DataTemplate DataType="nav:FileItem">
                                <Border Background="Transparent" PointerPressed="FileItem_PointerPressed">
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Abrir"
                                                      Command="{Binding $parent[Window].((vm:EditorViewModel)DataContext).OpenFileCommand}"
                                                      CommandParameter="{Binding}" />
                                            <MenuItem Header="Mostrar en carpeta"
                                                      Command="{Binding $parent[Window].((vm:EditorViewModel)DataContext).ShowInFolderCommand}"
                                                      CommandParameter="{Binding}" />
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <StackPanel Orientation="Horizontal" Spacing="6" Background="Transparent">
                                        <!-- Imagen -->
                                        <PathIcon Data="{StaticResource IconImage}" Width="14" Height="14" Foreground="{DynamicResource M3OnSurfaceVariantBrush}"/>
                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource M3OnSurfaceBrush}" FontSize="13" Padding="0,2" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </TreeView.DataTemplates>
                    </TreeView>
                </Grid>
            </Border>
            
        </Grid>

        <!-- Status Bar (Footer) -->
        <Border Grid.Row="2" Background="{DynamicResource M3SurfaceContainerHighBrush}" BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="0,1,0,0" Padding="12,4">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasImage}" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ImageWidth}" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" FontSize="11" />
                    <TextBlock Text="x" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" FontSize="11" />
                    <TextBlock Text="{Binding ImageHeight}" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" FontSize="11" />
                    <TextBlock Text="px" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" FontSize="11" />
                </StackPanel>
                
                <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <TextBlock Text="Listo" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" FontSize="11" />
                    <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding HasImage}">
                        <TextBlock Text="Archivo:" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" FontSize="11" />
                        <TextBlock Text="{Binding SelectedNode.Name}" Foreground="{DynamicResource M3OnSurfaceBrush}" FontSize="11" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

    </Grid>
</Window>
